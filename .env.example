# AdMob Ad Unit IDs
ANDROID_AD_APP_ID=your-android-ad-app-id
ANDROID_AD_UNIT_ID=your-android-ad-unit-id
IOS_AD_APP_ID=your-ios-ad-app-id
IOS_AD_UNIT_ID=your-ios-ad-unit-id

# Firebase
FIREBASE_PROJECT_NUMBER=your-firebase-project-number
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Android
FIREBASE_ANDROID_API_KEY=your-firebase-android-api-key
FIREBASE_ANDROID_APP_ID=your-firebase-android-app-id

# Firebase iOS
FIREBASE_IOS_API_KEY=your-firebase-ios-api-key
FIREBASE_IOS_APP_ID=your-firebase-ios-app-id

# Firebase Windows
FIREBASE_WINDOWS_API_KEY=your-firebase-windows-api-key
FIREBASE_WINDOWS_APP_ID=your-firebase-windows-app-id
FIREBASE_WINDOWS_MEASUREMENT_ID=your-firebase-windows-measurement-id

# Firebase Web
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_WEB_APP_ID=your-firebase-web-app-id
FIREBASE_WEB_MEASUREMENT_ID=your-firebase-web-measurement-id

# RevenueCat (Premium)
# Public SDK keys from the RevenueCat dashboard. Empty keys leave the
# paywall in a "store setup pending" state; the VPN itself keeps working.
REVENUECAT_APPLE_KEY=appl_your_public_sdk_key
REVENUECAT_GOOGLE_KEY=goog_your_public_sdk_key
# Cloud Function that redeems a cross-platform BULB code.
PREMIUM_REDEEM_URL=https://REGION-PROJECT.cloudfunctions.net/redeemCode

# Support
# Public Teleform form (or its Telegram hand-off). The Teleform dashboard is
# login-gated, so the shareable URL is copied out of the form's Publish step.
# Leave empty to hide the Support row entirely.
SUPPORT_URL=

# Store / Download Links
LINK_APP_STORE=https://apps.apple.com/us/app/your-app/idXXXXXXXXXX
LINK_TEST_FLIGHT=https://testflight.apple.com/join/XXXXXXXX
LINK_GITHUB=https://github.com/your-org/your-repo
LINK_GOOGLE_PLAY=https://play.google.com/store/apps/details?id=com.example.yourapp
